views:
  - type: table
    name: Table
    filters:
      and:
        - file.path.startsWith("content/Example dataset mapping/Strucke Data mapping")
        - file.name != "index"
        - file.name != "Strucke list of entities.base"
    order:
      - status
      - file.name
      - Entity_Name
      - Type
      - Public_ID
      - Target_Entity
      - Local_Keys
      - Remote_Keys
      - Target_Entity_2
      - Local_Keys_2
      - Remote_Keys_2
    sort:
      - property: file.name
        direction: ASC
      - property: status
        direction: ASC
